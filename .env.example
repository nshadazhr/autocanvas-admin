# Next.js only reads .env.local from within apps/admin itself (not the repo
# root, and not apps/web either — despite both apps sharing the same
# @platform/auth config/session cookie in dev). Copy the matching values
# from the root .env here — at minimum: DATABASE_URL, AUTH_SECRET.
#
# AUTH_GOOGLE_ID/AUTH_GOOGLE_SECRET are deliberately omitted — this app's
# login page is Credentials-only by design (see app/(auth)/login/page.tsx),
# since admin accounts are provisioned directly in the DB, not self-served
# via OAuth sign-up like apps/web's creator-facing flow.
#
# NEXT_PUBLIC_APP_URL points at apps/admin's own port (3001), not apps/web's
# 3000 — used for building absolute URLs (e.g. in emails), not for the
# session cookie, which is shared across both apps via localhost's
# port-agnostic cookie scoping in dev (see README's Chunk 8 notes for the
# production cross-subdomain caveat).

DATABASE_URL=""
AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3001"
